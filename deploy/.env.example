# Copy to deploy/.env on the VPS (vps-setup.sh does this) and fill in.
# Never commit the real .env.

# Backend image tag to run (set by the deploy workflow on every release).
NST_VERSION=v1.0.0

# Host names Caddy serves.  Until a real domain is bought, use sslip.io:
# it resolves any name containing the IP to that IP, e.g. for 203.0.113.5:
#   NST_PUBLIC_HOST=203-0-113-5.sslip.io
#   NST_CONSOLE_HOST=console.203-0-113-5.sslip.io
# With a domain later: point A records at the VPS and change these two lines.
NST_PUBLIC_HOST=
NST_CONSOLE_HOST=

# Contact address for Let's Encrypt certificate notices.
ACME_EMAIL=

# Private console access token (≥ 32 chars).  vps-setup.sh generates one.
NST_WEB_TOKEN=
